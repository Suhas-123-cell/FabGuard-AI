# Copy this file to .env. Never commit real keys.
FABGUARD_DATABASE_URL=postgresql+psycopg://fabguard:fabguard@localhost:5432/fabguard
FABGUARD_CHECKPOINT_DATABASE_URL=postgresql://fabguard:fabguard@localhost:5432/fabguard
FABGUARD_ARTIFACT_ROOT=runs/replays
FABGUARD_LLM_PROVIDER=groq
FABGUARD_LLM_MODEL=openai/gpt-oss-20b
FABGUARD_LLM_BASE_URL=https://api.groq.com/openai/v1
FABGUARD_LLM_API_KEY=
FABGUARD_AUDIO_ENABLED=true
FABGUARD_GRAPH_VERSION=fabguard-graph-v1
FABGUARD_PROMPT_VERSION=fabguard-report-v1
# Use three different random values. The producer cannot approve its own output.
FABGUARD_PRODUCER_TOKEN=
FABGUARD_ANALYST_TOKEN=
FABGUARD_REVIEWER_TOKEN=
FABGUARD_REVIEWER_SUBJECT=local-reviewer
